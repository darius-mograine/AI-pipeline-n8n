        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=вставьте_ключ",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Тема набора: {{ $json.theme }}. Пожелания продюсера: {{ $json.wishes }}. Составь набор из 10 карточек по правилам: Категория 1 (3 карточки) — объект без мелких деталей, висит в воздухе, фон одноцветный/градиент или простой узор. Категория 2 (3 карточки) — объект без мелких деталей, стоит на поверхности, позади вертикальная плоскость, простой фон. Категория 3 (2 карточки) — объект на реалистичной поверхности, объёмный фон. Категория 4 (2 карточки) — объект вписан в реалистичное окружение, остаётся центральным. Стиль всех карточек: казуальная мобильная 3D-иконка, яркие насыщенные цвета, мягкий свет, без текста, без рамки, без персонажей. Ответь СТРОГО в формате JSON-массива из 10 объектов с полями: name, category (число 1-4), prompt (детальный промпт для генерации картинки на английском языке). Никакого текста кроме JSON в ответе.\"\n    }]\n  }]\n}",
        "options": {}
      },
