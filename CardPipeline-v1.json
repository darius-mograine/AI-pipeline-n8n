      "parameters": {
        "jsCode": "const rawText = $json.candidates[0].content.parts[0].text;\nconst cleaned = rawText.replace(/```json|```/g, '').trim();\nconst cards = JSON.parse(cleaned);\n\nconst chatId = $('Разделение темы и пожелания').first().json.chatId;\nconst theme = $('Разделение темы и пожелания').first().json.theme;\n\nreturn cards.map(card => ({\n  json: { ...card, chatId, theme }\n}));"
