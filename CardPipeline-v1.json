      "parameters": {
        "jsCode": "const fs = require('fs');\nconst lockPath = 'D:\\\\n8n-card-pipeline\\\\pipeline.lock';\n\nif (fs.existsSync(lockPath)) {\n  const stats = fs.statSync(lockPath);\n  const ageMs = Date.now() - stats.mtimeMs;\n  const maxAgeMs = 10 * 60 * 1000; // 10 минут\n\n  if (ageMs < maxAgeMs) {\n    return [];\n  }\n  // замок старше 10 минут — считаем зависшим, снимаем сами\n  fs.unlinkSync(lockPath);\n}\n\nconst staticData = $getWorkflowStaticData('global');\nconst lastId = staticData.lastUpdateId || 0;\n\nconst updates = $input.first().json.result || [];\nconst newMessages = updates.filter(u => u.update_id > lastId);\n\nif (newMessages.length > 0) {\n  fs.writeFileSync(lockPath, 'locked');\n  staticData.lastUpdateId = newMessages[newMessages.length - 1].update_id;\n}\n\nreturn newMessages.map(u => ({ json: u }));"
      },
