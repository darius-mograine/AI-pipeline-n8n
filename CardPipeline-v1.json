      "parameters": {
        "jsCode": "const text = $json.message.text;\nconst chatId = $json.message.chat.id;\n\nconst themeMatch = text.match(/Тема:\\s*(.+)/i);\nconst wishesMatch = text.match(/Пожелания:\\s*(.+)/i);\n\nconst staticData = $getWorkflowStaticData('global');\nconst timestamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);\nconst folderPath = `D:\\\\n8n-card-pipeline\\\\Card\\\\${timestamp}`;\n\nstaticData.chatId = chatId;\nstaticData.folderPath = folderPath;\nstaticData.previewPaths = [];\n\nreturn [{\n  json: {\n    chatId: chatId,\n    theme: themeMatch ? themeMatch[1].trim() : '',\n    wishes: wishesMatch ? wishesMatch[1].trim() : '',\n    folderPath: folderPath\n  }\n}];"
